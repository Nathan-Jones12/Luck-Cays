# Copy to server/.env and fill in. server/.env is gitignored - never commit it.

# Aiven MySQL. Put the password between "avnadmin:" and "@".
# If the password contains special characters (@ : / ? # %), URL-encode them.
DATABASE_URL=mysql://avnadmin:PASSWORD@HOST:PORT/defaultdb?ssl-mode=REQUIRED

# Optional but recommended: path to Aiven's CA certificate (download ca.pem from the
# service's Overview page). With it the server's certificate is verified, not just encrypted.
# DATABASE_CA_PATH=./ca.pem

PORT=4000

# ---------------------------------------------------------------------------
# Luck-Cays environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database -------------------------------------------------------------
# The prototype runs on SQLite so it needs no Docker. The canonical schema in
# prisma/schema.prisma targets MySQL 8 (see PRD); `npm run db:push` rewrites it
# to SQLite when DATABASE_PROVIDER=sqlite.
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# MySQL (the production path - start it with `docker compose up -d mysql redis`)
# DATABASE_PROVIDER=mysql
# DATABASE_URL="mysql://luckcays:luckcays@localhost:3306/luckcays"

# --- Redis ----------------------------------------------------------------
# Leave blank to use the in-process fallback (rate limits + poker state held in
# memory). Required if you run more than one API instance.
REDIS_URL=

# --- Auth -----------------------------------------------------------------
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# AES-256-GCM key for TOTP secrets at rest. Exactly 32 bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktZGV2LW9ubHktMDA=

# --- Server ---------------------------------------------------------------
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# Set true behind a TLS-terminating proxy so Secure cookies and HSTS apply.
TRUST_PROXY=false

# --- Embedding (see docs/embedding.md) -------------------------------------
# Where the embeddable game bundle is served. In production this MUST be a different
# origin to the host sites - that separation is what makes the iframe a real boundary.
GAME_ORIGIN=http://localhost:5173

# Our other front-ends allowed to embed a game, comma separated. WEB_ORIGIN is always
# allowed. This is an allowlist of OUR sites, not a way to let third parties in.
EMBED_ORIGINS=

# --- Economy (seeded into the config table, editable in admin) -------------
SIGNUP_BONUS_CHIPS=10000
DAILY_BONUS_CHIPS=2500

# --- Sports data API ------------------------------------------------------
# Unset => the sync job seeds deterministic demo fixtures instead of calling out.
SPORTS_API_KEY=
SPORTS_API_BASE=https://api.the-odds-api.com/v4
SPORTS_SYNC_CRON=*/15 * * * *

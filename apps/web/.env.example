# Replace placeholders in .env.local; never put real credentials in this template.
DATABASE_URL=mysql://username:password@mysql-host:port/database?ssl-mode=REQUIRED
# Optional account reserved for schema migration and one-time bootstrap operations.
MIGRATION_DATABASE_URL=mysql://username:password@mysql-host:port/database?ssl-mode=REQUIRED
# Optional Aiven CA certificate path, relative to apps/web.
MYSQL_SSL_CA=./certs/aiven-ca.pem

# Existing Firebase Auth can be reused; Luck-Cays roles stay in its own MySQL tables.
FIREBASE_PROJECT_ID=luck-cays-firebase-project-id
NEXT_PUBLIC_FIREBASE_PROJECT_ID=luck-cays-firebase-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=luck-cays-firebase-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=replace-with-firebase-web-app-id

# Generate a random 32-byte key and store its base64 value here.
ADMIN_TOTP_ENCRYPTION_KEY=replace-with-base64-32-byte-key
BOOTSTRAP_ADMIN_FIREBASE_UID=replace-with-firebase-user-uid
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CONTENT_ADMIN_FIREBASE_UID=replace-with-another-firebase-user-uid
CONTENT_ADMIN_EMAIL=content-admin@example.com

ENABLE_REAL_MONEY=false
ENABLE_DEPOSITS=false
ENABLE_WITHDRAWALS=false
ENABLE_LIVE_CASINO=false
ENABLE_SPORTS=false
ENABLE_PROMOTIONS=false
ENABLE_VIP=false
ENABLE_KYC=false
ENABLE_GEOLOCATION=false
ENABLE_MAINTENANCE_MODE=false

{
  "name": "luck-cays-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:create-tables": "tsx --env-file=.env scripts/create-tables.ts",
    "db:sql": "tsx --env-file=.env scripts/run-sql.ts",
    "job:lossback": "tsx --env-file=.env scripts/pay-lossback.ts",
    "test:lossback": "tsx --env-file=.env scripts/test-lossback.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
